from ctypes import _CArgObject

from win32more._win32 import ComPtr
from win32more.Windows.Win32.Graphics.Direct2D.Common import D2D1_BEZIER_SEGMENT, D2D_POINT_2F

class ID2D1Factory(ComPtr):
    def CreatePathGeometry(self, result: ID2D1PathGeometry) -> int: ...

class ID2D1Geometry(ComPtr): ...

class ID2D1PathGeometry(ComPtr):
    def Open(self, sink: ID2D1GeometrySink) -> int: ...

class ID2D1GeometrySink(ComPtr):
    def BeginFigure(self, point: D2D_POINT_2F, begin: int) -> None: ...
    def AddLine(self, point: D2D_POINT_2F) -> None: ...
    def AddBezier(self, curve: D2D1_BEZIER_SEGMENT) -> None: ...
    def EndFigure(self, end: int) -> None: ...
    def Close(self) -> int: ...

def D2D1CreateFactory(factory_type: int, iid: _CArgObject, options: None, result: _CArgObject) -> int: ...
