# Consumed clipboard calls. Handles are pointer-sized integers; BOOL results are ints.
import ctypes

def OpenClipboard(owner: int) -> int: ...
def CloseClipboard() -> int: ...
def EmptyClipboard() -> int: ...
def SetClipboardData(format: int, memory: int) -> int | None: ...

class COPYDATASTRUCT(ctypes.Structure):
    dwData: int
    cbData: int
    lpData: int | None
