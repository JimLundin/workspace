# Consumed native desktop lifecycle contract. Handles are pointer-sized integers;
# null optional device/mode/security pointers use Windows defaults.
def CreateDesktopW(name: str, device: None, mode: None, flags: int, access: int, security: None) -> int | None: ...
def CloseDesktop(handle: int) -> int: ...
def GetThreadDesktop(thread: int) -> int | None: ...
def OpenInputDesktop(flags: int, inherit: int, access: int) -> int | None: ...
def GetUserObjectInformationW(handle: int, index: int, buffer: int, length: int, needed: None) -> int: ...
