from collections.abc import Awaitable, Iterable

from win32more._win32 import ComPtr
from win32more.Windows.UI.Notifications import UserNotification

class UserNotificationListenerAccessStatus:
    Allowed: int

class UserNotificationListener(ComPtr):
    @classmethod
    def get_Current(cls) -> UserNotificationListener: ...
    def GetAccessStatus(self) -> int: ...
    def GetNotificationsAsync(self, kinds: int) -> Awaitable[Iterable[UserNotification]]: ...
    def GetNotification(self, notification_id: int, /) -> UserNotification: ...
    def RemoveNotification(self, notification_id: int, /) -> None: ...
