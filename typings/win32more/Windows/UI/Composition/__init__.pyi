from win32more._win32 import ComPtr
from win32more.Windows.Foundation.Numerics import Vector2, Vector3
from win32more.Windows.UI import Color

class ExpressionAnimation(ComPtr):
    def SetReferenceParameter(
        self,
        key: str,
        composition_object: ContainerVisual | CompositionPropertySet,
    ) -> None: ...

class CompositionPropertySet(ComPtr):
    def InsertScalar(self, property_name: str, value: float) -> None: ...

class CompositionRoundedRectangleGeometry(ComPtr):
    Offset: Vector2
    Size: Vector2
    CornerRadius: Vector2
    def StartAnimation(
        self, property_name: str, animation: ExpressionAnimation
    ) -> None: ...

class ICompositionRoundedRectangleGeometry(ComPtr):
    Offset: Vector2
    Size: Vector2
    CornerRadius: Vector2

class IVisual(ComPtr):
    Size: Vector2
    Offset: Vector3
    Opacity: float

class CompositionGeometricClip(ComPtr):
    Geometry: CompositionRoundedRectangleGeometry

class CompositionBackdropBrush(ComPtr): ...
class CompositionSurfaceBrush(ComPtr): ...

class CompositionColorBrush(ComPtr):
    Color: Color

class CompositionColorGradientStop(ComPtr): ...

class CompositionColorGradientStopCollection(ComPtr):
    def Append(self, value: CompositionColorGradientStop) -> None: ...
    def Clear(self) -> None: ...

class CompositionLinearGradientBrush(ComPtr):
    def put_StartPoint(self, value: Vector2) -> None: ...
    def put_EndPoint(self, value: Vector2) -> None: ...
    @property
    def ColorStops(self) -> CompositionColorGradientStopCollection: ...

class CompositionSpriteShape(ComPtr):
    Geometry: CompositionRoundedRectangleGeometry
    def put_FillBrush(self, value: CompositionColorBrush) -> None: ...
    def put_StrokeBrush(
        self, value: CompositionLinearGradientBrush
    ) -> None: ...
    def put_StrokeThickness(self, value: float) -> None: ...

class CompositionShapeCollection(ComPtr):
    def Append(self, shape: CompositionSpriteShape) -> None: ...

class VisualCollection(ComPtr):
    def InsertAtTop(
        self, visual: ContainerVisual | SpriteVisual | ShapeVisual
    ) -> None: ...

class ContainerVisual(ComPtr):
    Size: Vector2
    Offset: Vector3
    Opacity: float
    def StartAnimation(
        self, property_name: str, animation: ExpressionAnimation
    ) -> None: ...
    def put_Clip(self, value: CompositionGeometricClip) -> None: ...
    @property
    def Children(self) -> VisualCollection: ...

class SpriteVisual(ComPtr):
    Size: Vector2
    Offset: Vector3
    def put_RelativeSizeAdjustment(self, value: Vector2) -> None: ...
    def put_Brush(
        self,
        value: CompositionColorBrush
        | CompositionBackdropBrush
        | CompositionSurfaceBrush,
    ) -> None: ...
    def put_Shadow(self, value: DropShadow) -> None: ...
    def StartAnimation(
        self, property_name: str, animation: ExpressionAnimation
    ) -> None: ...

class ShapeVisual(ComPtr):
    Size: Vector2
    def put_RelativeSizeAdjustment(self, value: Vector2) -> None: ...
    def StartAnimation(
        self, property_name: str, animation: ExpressionAnimation
    ) -> None: ...
    @property
    def Shapes(self) -> CompositionShapeCollection: ...

class CompositionVisualSurface(ComPtr):
    def put_SourceVisual(self, value: ShapeVisual) -> None: ...
    SourceSize: Vector2
    def StartAnimation(
        self, property_name: str, animation: ExpressionAnimation
    ) -> None: ...

class DropShadow(ComPtr):
    Color: Color
    Offset: Vector3
    def put_Opacity(self, value: float) -> None: ...
    def put_Mask(self, value: CompositionSurfaceBrush) -> None: ...
    def put_BlurRadius(self, value: float) -> None: ...

class Compositor(ComPtr):
    def __init__(self) -> None: ...
    def Close(self) -> None: ...
    def CreateContainerVisual(self) -> ContainerVisual: ...
    def CreateSpriteVisual(self) -> SpriteVisual: ...
    def CreateShapeVisual(self) -> ShapeVisual: ...
    def CreateVisualSurface(self) -> CompositionVisualSurface: ...
    def CreateDropShadow(self) -> DropShadow: ...
    def CreateHostBackdropBrush(self) -> CompositionBackdropBrush: ...
    def CreateColorBrush(self) -> CompositionColorBrush: ...
    def CreateColorBrushWithColor(
        self, color: Color
    ) -> CompositionColorBrush: ...
    def CreateSurfaceBrushWithSurface(
        self, surface: CompositionVisualSurface
    ) -> CompositionSurfaceBrush: ...
    def CreateRoundedRectangleGeometry(
        self,
    ) -> CompositionRoundedRectangleGeometry: ...
    def CreateGeometricClipWithGeometry(
        self, geometry: CompositionRoundedRectangleGeometry
    ) -> CompositionGeometricClip: ...
    def CreateSpriteShapeWithGeometry(
        self, geometry: CompositionRoundedRectangleGeometry
    ) -> CompositionSpriteShape: ...
    def CreateExpressionAnimationWithExpression(
        self, expression: str
    ) -> ExpressionAnimation: ...
    def CreatePropertySet(self) -> CompositionPropertySet: ...
    def CreateLinearGradientBrush(self) -> CompositionLinearGradientBrush: ...
    def CreateColorGradientStopWithOffsetAndColor(
        self, offset: float, color: Color
    ) -> CompositionColorGradientStop: ...
