import ctypes

from win32more._win32 import ComPtr

class IAsyncInfo(ComPtr):
    @property
    def Status(self) -> int: ...
    def Cancel(self) -> None: ...
    def Close(self) -> None: ...

class IAsyncAction(ComPtr): ...

class TimeSpan(ctypes.Structure):
    def __init__(self, duration: int) -> None: ...
    Duration: int
