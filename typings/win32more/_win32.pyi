import ctypes
from typing import ClassVar

class Guid(ctypes.Structure):
    def __init__(self, value: str) -> None: ...

class ComPtr(ctypes.c_void_p):
    _iid_: ClassVar[Guid]
    def __init__(self, *, own: bool = False) -> None: ...
    def as_[T: ComPtr](self, interface: type[T]) -> T: ...
    def AddRef(self) -> int: ...
