"""Only the generators consumed by Workspace's property cases."""

from collections.abc import Callable, Sequence
from typing import Protocol

class SearchStrategy[T]: ...

class DrawFn(Protocol):
    def __call__[T](self, strategy: SearchStrategy[T], /) -> T: ...

def composite[T](build: Callable[[DrawFn], T]) -> Callable[[], SearchStrategy[T]]: ...
def one_of[T](*strategies: SearchStrategy[T]) -> SearchStrategy[T]: ...
def sampled_from[T](elements: Sequence[T]) -> SearchStrategy[T]: ...
def integers(min_value: int, max_value: int) -> SearchStrategy[int]: ...
def floats(min_value: float, max_value: float, *, width: int) -> SearchStrategy[float]: ...
def lists[T](elements: SearchStrategy[T], *, min_size: int = 0, max_size: int) -> SearchStrategy[list[T]]: ...
def text(*, min_size: int = 0, max_size: int) -> SearchStrategy[str]: ...
def booleans() -> SearchStrategy[bool]: ...
